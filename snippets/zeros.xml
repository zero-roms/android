<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZeroS manifest snippet, included from default.xml.

  Two layers, kept apart on purpose (see ROM_PLAN.md, multi-device design):
    common layer  - vendor/zeros: everything that makes this ROM ZeroS
    device layer  - one device tree, kernel and blobs per phone. Mirrored
                    into zero-roms from LineageOS/TheMuppets (change 7,
                    20 October 2026) so builds never depend on upstream
                    repos staying put; kept identical to upstream until
                    ZeroS needs its own device patches. Refresh the mirrors
                    from upstream before each monthly build (HANDBOOK.md).
-->
<manifest>

  <!-- ZeroS common layer -->
  <project name="zero-roms/android_vendor_zeros" path="vendor/zeros" remote="github" revision="zeros-24.0" />

  <!-- Google apps for the Google build (Phase 3A, decided 23 October 2026).
       Read from MindTheGapps directly, not mirrored into zero-roms: these
       are Google's binaries, and ZeroS does not republish them under its
       own name. Pinned to a commit and fetched shallow (the history holds
       gigabytes of old APKs). vendor/zeros/config/gapps.mk picks the
       modules ZeroS ships; nothing here is installed unless listed there.
       Update the pin deliberately, one build at a time. -->
  <project name="MindTheGapps/vendor_gapps" path="vendor/gapps" remote="github" revision="822ff6a805533792ae43a9c3f2a159222da22a6f" upstream="cinnamonbun" clone-depth="1" />

  <!-- Device layer: Xiaomi Redmi Note 8 (ginkgo), Snapdragon 665 (sm6125) -->
  <project name="zero-roms/android_device_xiaomi_ginkgo"             path="device/xiaomi/ginkgo"        remote="github" revision="lineage-24.0" />
  <project name="zero-roms/android_device_xiaomi_sm6125-common"      path="device/xiaomi/sm6125-common" remote="github" revision="lineage-24.0" />
  <project name="zero-roms/android_hardware_xiaomi"                  path="hardware/xiaomi"             remote="github" revision="lineage-24.0" />
  <project name="zero-roms/android_kernel_xiaomi_sm6125"             path="kernel/xiaomi/sm6125"        remote="github" revision="lineage-24.0" />
  <project name="zero-roms/proprietary_vendor_xiaomi_ginkgo"        path="vendor/xiaomi/ginkgo"        remote="github" revision="lineage-24.0" />
  <project name="zero-roms/proprietary_vendor_xiaomi_sm6125-common" path="vendor/xiaomi/sm6125-common" remote="github" revision="lineage-24.0" />

</manifest>
